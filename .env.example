# Copy to .env and adjust. `docker compose` reads .env automatically.
#
# WARNING: these are development defaults. Any environment that is not a
# throwaway local container MUST override both secrets.

# AES-256-GCM master key for endpoint signing secrets. 32+ characters.
# Losing this orphans every stored endpoint secret.
HOOKFLOW_MASTER_KEY=hookflow-dev-master-key-change-in-production-32

# Operator credential for /v1/admin/**. Not a tenant credential.
HOOKFLOW_BOOTSTRAP_TOKEN=hookflow-dev-bootstrap-token

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_NAME=hookflow
DB_USER=hookflow
DB_PASSWORD=hookflow

# RabbitMQ
MQ_HOST=localhost
MQ_PORT=5672
MQ_USER=hookflow
MQ_PASSWORD=hookflow

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# App
SERVER_PORT=8080
LOG_LEVEL=INFO

# MySQL host port, if 3306 is already taken on the host.
# Set DB_PORT to the same value so the app connects to the container.
# DB_PUBLISH_PORT=13306

# Grafana (docker compose --profile monitoring). Demo password by default.
GRAFANA_PASSWORD=hookflow

# Worker pool (the listener container IS the worker pool; both are bounded)
MQ_CONCURRENCY=2
MQ_MAX_CONCURRENCY=8
MQ_PREFETCH=8
# Broker-side queue cap; 0 disables it. Changing it on an existing queue requires
# recreating the queue (RabbitMQ refuses an argument change).
MQ_MAX_QUEUE_LENGTH=20000

# Fair scheduling (v0.3). Set to false to reproduce the v0.2 behaviour.
FAIRNESS_ENABLED=true

# Load shedding (v0.3). Size the tenant watermark as
# "acceptable wait x drain rate", not "as large as possible" - see docs/capacity.md.
OUTBOX_HIGH_WATERMARK=100000
TENANT_HIGH_WATERMARK=10000

# Worker reaction when a message arrives for a tenant already at its budget:
# defer (ack, let recovery requeue) or requeue (immediate redelivery).
WORKER_OVER_CAPACITY_POLICY=defer

# Tracing (v0.3). Export is opt-in; nothing breaks without a collector.
TRACING_ENABLED=true
TRACING_SAMPLE=1.0
OTLP_EXPORT=false
OTLP_ENDPOINT=http://localhost:4318/v1/traces
